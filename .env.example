# 环境变量模板
#
# 用法：把这个文件复制一份，改名为 .env，然后填入真实的值。
#     cp .env.example .env
#
# 重要：.env 已经被 .gitignore 排除，永远不会被提交到 Git。
# 绝对不要把真实密钥写在这个 .example 文件里，也不要直接提交 .env。
#
# 在代码里这样读取（第 2 周会用到 python-dotenv）：
#     import os
#     from dotenv import load_dotenv
#     load_dotenv()
#     api_key = os.getenv("DASHSCOPE_API_KEY")

# ── 大模型 API 密钥（第 8 周开始用）──
# 通义千问 DashScope：https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=

# DeepSeek：https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# OpenAI 兼容接口
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ── 应用配置 ──
# 默认使用哪个模型
DEFAULT_MODEL=

# 数据库文件路径
DATABASE_PATH=./data/app.db

# 运行环境：development / production
ENVIRONMENT=development

# ── 八字排盘服务（Day 19 加入）──
# 不填就用代码里的默认值；填了以 .env 为准。
# 数据库文件绝对路径（不填默认 paipan/data/charts.db）
PAIPAN_DB=
# 监听地址：开发用 127.0.0.1，公网部署才考虑 0.0.0.0
PAIPAN_HOST=127.0.0.1
# 端口：8000 被网页版 app.py 占着，接口默认 8001
PAIPAN_PORT=8001
# 允许跨域的来源。开发期 * 方便，上线必须换成具体域名（逗号分隔）
PAIPAN_ALLOW_ORIGIN=*
